{
  "name": "zra-os-agent",
  "version": "0.1.0",
  "description": "Multi-domain assistant (legal, finance, CAD, evidence, ops) optimized for high-reliability structured output.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zra": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "serve": "tsx src/server.ts",
    "chat": "tsx src/cli.ts",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "agent",
    "legal",
    "jewelry",
    "cad",
    "finance",
    "evidence",
    "llm"
  ],
  "author": "Zachary Robert Ancona",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
